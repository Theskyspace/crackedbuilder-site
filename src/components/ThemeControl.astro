---
---
<div class="theme-control" role="group" aria-label="Color theme">
  <button type="button" data-theme-choice="light" aria-label="Light theme" aria-pressed="false" title="Light theme">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
    <span>Light</span>
  </button>
  <button type="button" data-theme-choice="dark" aria-label="Dark theme" aria-pressed="false" title="Dark theme">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg>
    <span>Dark</span>
  </button>
  <button type="button" data-theme-choice="system" aria-label="System theme" aria-pressed="true" title="Follow system theme">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
    <span>System</span>
  </button>
</div>
<style>
  .theme-control { position: fixed; right: max(24px, env(safe-area-inset-right)); bottom: max(20px, env(safe-area-inset-bottom)); z-index: 40; display: flex; align-items: center; gap: 3px; padding: 5px; background: var(--color-page); color: var(--color-ink-400); border: 1px solid var(--color-rule-800); border-radius: 999px; box-shadow: 0 4px 20px #00000012; }
  button { display: flex; align-items: center; gap: 6px; padding: 14px 11px; border-radius: 999px; font-size: 11px; line-height: 16px; cursor: pointer; }
  button:hover { background: var(--color-panel); color: var(--color-ink-100); }
  button[aria-pressed="true"] { background: var(--color-selection); color: var(--color-ink-900); }
  button:focus-visible { outline: 2px solid var(--color-ink-400); outline-offset: 2px; }
  svg { width: 15px; height: 15px; flex-shrink: 0; }
  @media(max-width: 480px) { .theme-control { right: 16px; bottom: max(16px, env(safe-area-inset-bottom)); } }
</style>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  let busy = false;
  const choice = () => document.documentElement.dataset.theme || 'system';
  const sync = () => {
    const selected = choice();
    buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === selected)));
    const dark = selected === 'dark' || (selected === 'system' && system.matches);
    document.querySelectorAll('meta[name="theme-color"]').forEach(meta => meta.setAttribute('content', dark ? '#0a0a0a' : '#fafafa'));
  };
  const apply = (mode: string) => {
    if (mode === 'system') delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = mode;
    try { localStorage.setItem('cb-theme', mode); } catch {}
    sync();
  };
  sync();
  system.addEventListener('change', sync);
  window.addEventListener('storage', event => {
    if (event.key !== 'cb-theme') return;
    const mode = event.newValue;
    if (mode === 'light' || mode === 'dark') document.documentElement.dataset.theme = mode;
    else delete document.documentElement.dataset.theme;
    sync();
  });
  buttons.forEach(button => button.addEventListener('click', async () => {
    const mode = button.dataset.themeChoice!;
    if (busy || choice() === mode) return;
    const wasDark = getComputedStyle(document.documentElement).colorScheme === 'dark';
    const willBeDark = mode === 'dark' || (mode === 'system' && system.matches);
    if (!document.startViewTransition || reduced.matches || wasDark === willBeDark) { apply(mode); return; }
    const rect = button.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    busy = true;
    try {
      const transition = document.startViewTransition(() => apply(mode));
      await transition.ready;
      const animation = document.documentElement.animate({clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`]}, {duration: 560, easing: 'cubic-bezier(.4,0,.2,1)', fill: 'both', pseudoElement: '::view-transition-new(root)'});
      await animation.finished;
      await transition.finished;
      animation.cancel();
    } catch { apply(mode); }
    finally { busy = false; }
  }));
</script>
