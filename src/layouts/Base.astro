---
import '../styles/global.css';
import { url } from '../lib/format';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const {
  title = 'Akash Joshi — developer, occasional writer, who overthinks in public',
  description = 'Akash Joshi, founding engineer. Fintech, identity and AI agent systems in production. Writing on fintech infra and building under ambiguity.',
  wide = false,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = url('/').replace(/\/$/, '');
const isActive = (p: string) => {
  const full = url(p).replace(/\/$/, '');
  if (p === '/') return path === home;
  return path === full || path.startsWith(full + '/');
};

const navLinks = [
  { href: '/writing', label: 'writing' },
  { href: '/work', label: 'work' },
  { href: '/projects', label: 'projects' },
  { href: '/about', label: 'about' },
];
---

<!doctype html>
<html lang="en" class="bg-neutral-950 text-neutral-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://crackedbuilder.com/og-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pixel avatar of Akash Joshi with sunglasses, next to the text: 2x founding engineer. Cracked builder." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://crackedbuilder.com/og-card.png" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <script is:inline>
      try {
        if (sessionStorage.getItem('cb-loader-seen')) {
          document.documentElement.classList.add('loader-skip');
        }
      } catch (e) {}
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="48x48" href={url('/favicon-48.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title="Akash Joshi — Writing" href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
  </head>
  <body class="bg-neutral-950 font-sans antialiased text-[15px] leading-7 text-neutral-300 selection:bg-neutral-100 selection:text-neutral-900">
    <div
      id="loader-overlay"
      class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-neutral-950 transition-opacity duration-300"
      role="status"
      aria-live="polite"
    >
      <img src={url('/loader-face.webp')} alt="" width="140" height="140" class="loader-face" />
      <div id="loader-phrase" class="loader-phrase"></div>
    </div>
    <div class={`mx-auto px-6 py-10 md:py-16 ${wide ? 'max-w-3xl' : 'max-w-2xl'}`}>
      <nav class="mb-14 flex items-center justify-between text-sm text-neutral-400">
        <a
          href={url('/')}
          class="font-medium text-neutral-100 hover:text-neutral-400 transition-colors"
          aria-current={isActive('/') ? 'page' : undefined}
        >
          akash joshi
        </a>
        <div class="flex items-center gap-5">
          {navLinks.map((l) => (
            <a
              href={url(l.href)}
              class={`transition-colors ${isActive(l.href) ? 'text-neutral-100' : 'hover:text-neutral-100'}`}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          ))}
        </div>
      </nav>
      <slot />
      <footer class="mt-24 pt-8 border-t border-neutral-900 flex flex-wrap items-center justify-between gap-3 text-xs text-neutral-500">
        <span>akash joshi · {new Date().getFullYear()}</span>
        <span class="flex items-center gap-4">
          <a href="https://github.com/theskyspace" class="hover:text-neutral-200 transition-colors">github</a>
          <a href="https://linkedin.com/in/theskyspace" class="hover:text-neutral-200 transition-colors">linkedin</a>
          <a href="mailto:theskyspacedev@gmail.com" class="hover:text-neutral-200 transition-colors">theskyspacedev@gmail.com</a>
          <a href={url('/resume')} class="hover:text-neutral-200 transition-colors">resume</a>
          <a href="#" data-loader-replay class="hover:text-neutral-200 transition-colors">replay intro</a>
        </span>
      </footer>
    </div>
    <style>
      .loader-face {
        width: 140px;
        height: 140px;
        margin-top: -16px; /* trims the sprite's transparent headroom */
        image-rendering: pixelated;
      }
      .loader-phrase {
        margin-top: -13px; /* trims most of the sprite's transparent floor, leaving breathing room under the chin */
        color: #a3a3a3;
        opacity: 0.5;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 11px;
        letter-spacing: 0.02em;
        min-height: 1.2em;
        transform: translateY(0);
        transition: opacity 240ms ease, transform 240ms ease;
      }
      .loader-phrase.is-hidden {
        opacity: 0;
        transform: translateY(3px);
      }
      #loader-overlay.loader-done {
        opacity: 0;
        pointer-events: none;
      }
      :global(html.loader-skip) #loader-overlay {
        display: none;
      }
    </style>
    <script is:inline>
      (() => {
        const FACTS = [
          'overthinks in public',
          'music head, guitar too',
          'lifts metal, literally',
          'building since nineteen',
          'catches wrong chords by ear',
          'ships quiet convenience',
          'occasional writer',
        ];
        const overlay = document.getElementById('loader-overlay');
        const el = document.getElementById('loader-phrase');
        if (!overlay || !el) return;
        let visibleTimer, swapTimer, endTimer;
        const run = () => {
          const lines = [...FACTS].sort(() => Math.random() - 0.5);
          let i = 0;
          overlay.classList.remove('loader-done');
          el.textContent = lines[0];
          el.classList.remove('is-hidden');
          const tick = () => {
            el.classList.add('is-hidden');
            swapTimer = setTimeout(() => {
              i = (i + 1) % lines.length;
              el.textContent = lines[i];
              el.classList.remove('is-hidden');
            }, 240);
            visibleTimer = setTimeout(tick, 2440);
          };
          visibleTimer = setTimeout(tick, 2200);
          // random 1-3s hold, then fade the overlay away
          endTimer = setTimeout(() => {
            clearTimeout(visibleTimer);
            clearTimeout(swapTimer);
            overlay.classList.add('loader-done');
            setTimeout(() => { overlay.style.display = 'none'; }, 350);
          }, 1000 + Math.random() * 2000);
        };
        let seen = null;
        try { seen = sessionStorage.getItem('cb-loader-seen'); } catch (e) {}
        if (seen) {
          overlay.style.display = 'none';
        } else {
          try { sessionStorage.setItem('cb-loader-seen', '1'); } catch (e) {}
          run();
        }
        document.querySelectorAll('[data-loader-replay]').forEach((b) =>
          b.addEventListener('click', (e) => {
            e.preventDefault();
            clearTimeout(visibleTimer);
            clearTimeout(swapTimer);
            clearTimeout(endTimer);
            document.documentElement.classList.remove('loader-skip');
            overlay.style.display = 'flex';
            run();
          })
        );
      })();
    </script>
  </body>
</html>
